<UserControl
    x:Class="LifeManagementAppWPF.Sources.TabItems.UserInfoTabItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:LifeManagementAppWPF.Sources.TabItems"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding TabItemLoaded}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <GroupBox
            MinWidth="200"
            Margin="20"
            HorizontalAlignment="Left"
            Header="Personal Data">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Label Margin="5" Content="Name" />
                <TextBox
                    Grid.Column="1"
                    Text="{Binding UserInfoTabData.Name}"
                    MinWidth="120"
                    Margin="5"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left" />
                <Label
                    Grid.Row="1"
                    Margin="5"
                    Content="Last Name" />
                <TextBox
                    Grid.Row="1"
                    Text="{Binding UserInfoTabData.LastName}"
                    Grid.Column="1"
                    MinWidth="120"
                    Margin="5"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left" />

            </Grid>

        </GroupBox>

    </Grid>
</UserControl>