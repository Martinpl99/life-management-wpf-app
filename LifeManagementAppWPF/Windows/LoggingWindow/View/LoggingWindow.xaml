<mah:MetroWindow x:Class="LifeManagementAppWPF.Windows.LoggingWindow.View.LoggingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LifeManagementAppWPF.Windows.LoggingWindow.ViewModel"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:commonBehaviors="clr-namespace:LifeManagementAppWPF.Common.Windows.Behaviors"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        SizeToContent="WidthAndHeight"
        mc:Ignorable="d"
        Title="Give your user id" Height="450" Width="800">

    <i:Interaction.Behaviors>
        <commonBehaviors:OkCancelDailogBehavior/>
    </i:Interaction.Behaviors>

    <Window.DataContext>
        <local:LoggingWindowVM/>
    </Window.DataContext>
    
    <Window.Resources>
        <Thickness x:Key="marginResource" Left="50" Right="50" Bottom="10" Top="10"/>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="200"/>
            <ColumnDefinition MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Grid.Column="0"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"
                   Margin="{StaticResource marginResource}"
                   HorizontalContentAlignment="Left"
                   VerticalContentAlignment="Center"
                   Content="User Id :"/>

        <TextBox Grid.Column="1"
                  Margin="{StaticResource marginResource}"
                 Name="InputTextBox"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"/>

        <Button Grid.Row="1"
                Content="OK"
                MaxHeight="50"
                Margin="{StaticResource marginResource}"
                Command="{Binding OnOkCommand}"
                IsDefault="True"/>
        
        <Button Grid.Row="1"
                Grid.Column="1"
                MaxHeight="50"
                Margin="{StaticResource marginResource}"
                Command="{Binding OnCancelCommand}"
                Content="Cancel" />
    </Grid>
</mah:MetroWindow>
