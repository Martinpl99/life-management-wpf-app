<mah:MetroWindow x:Class="LifeManagementAppWPF.MainWnd.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LifeManagementAppWPF"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:vm="clr-namespace:LifeManagementAppWPF"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:commonBehaviors="clr-namespace:LifeManagementAppWPF.Common.Windows.Behaviors"
        xmlns:views="clr-namespace:LifeManagementAppWPF.Sources.TabItems"
        xmlns:interfaces="clr-namespace:LifeManagementAppWPF.Sources.TabItems.Interface"
        mc:Ignorable="d"
        Title="Life Management App" Height="450" Width="800">

    <i:Interaction.Behaviors>
        <commonBehaviors:OkCancelDailogBehavior/>
    </i:Interaction.Behaviors>
    
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding WindowLoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TabControl 
            mah:HeaderedControlHelper.HeaderFontSize="20"
            mah:TabControlHelper.Underlined="TabItems"
            ItemsSource="{Binding TabItems}"
            TabStripPlacement="Top">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type interfaces:ITabItemVM}">
                    <TextBlock Text="{Binding Header}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate DataType="{x:Type interfaces:IUserInfoTabViewModel}">
                    <views:UserInfoTabItem />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        
        <!--<Button Style="{DynamicResource MahApps.Styles.Button}" Grid.Row="1" Content="CLICK ME" Command="{Binding ButtonClickCommand}"></Button>-->
    </Grid>
</mah:MetroWindow>
